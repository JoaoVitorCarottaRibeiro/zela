# Chave gratuita do Google AI Studio (Gemini) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelos
GEMINI_MODEL=gemini-flash-lite-latest   # leve e rápido; troque p/ gemini-flash-latest se quiser o modelo cheio
WHISPER_MODEL=small               # STT offline (tiny | base | small | medium)

# Opcional: redundância gratuita
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Voz offline (Piper) — opcional. Baixe em https://github.com/rhasspy/piper
PIPER_BIN=
PIPER_VOICE=

# Banco de dados — Supabase (PostgreSQL). Pegue em: botão "Connect" > Session pooler.
# Troque o início para postgresql+psycopg:// e termine em /postgres.
# IMPORTANTE: se a senha tiver caracteres especiais, use letras/números (reset no
# Supabase) ou faça o URL-encode (@ -> %40, # -> %23, etc.). Em branco => SQLite local.
DATABASE_URL=

# Opcional: senha do banco separada. Se preenchida, substitui a senha do DATABASE_URL
# (o código faz o escape). Prático quando a senha tem caracteres especiais.
DB_PASSWORD=

# Supabase (opcional) — só se formos usar o cliente/REST do Supabase
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Autenticação — chave para assinar os tokens de login. Troque por um valor
# aleatório em produção. TOKEN_EXP_HORAS controla a validade do login.
SECRET_KEY=
TOKEN_EXP_HORAS=72

# Recuperação de senha — validade do link enviado por e-mail (em minutos).
RESET_EXP_MIN=30

# Envio de e-mail (recuperação de senha). Em branco => modo SIMULADO: o e-mail é
# gravado em ia/emails_dev.log em vez de enviado (bom para desenvolvimento/demo).
# Para enviar de verdade, preencha os dados do seu servidor SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Zela <nao-responda@zela.local>
SMTP_TLS=true

# URL do site, usada para montar o link de redefinição no e-mail.
FRONTEND_URL=http://localhost:3000
