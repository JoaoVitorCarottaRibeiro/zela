{
  "name": "zela-mobile",
  "version": "1.0.0",
  "description": "Zela — app do cidadão (triagem e orientação em saúde para comunidades).",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "~14.0.4",
    "expo": "~52.0.11",
    "expo-av": "~15.0.1",
    "expo-build-properties": "~0.13.3",
    "expo-constants": "~17.0.3",
    "expo-document-picker": "~13.0.3",
    "expo-font": "~13.0.4",
    "expo-image-picker": "~16.0.3",
    "expo-linking": "~7.0.3",
    "expo-location": "~18.0.10",
    "expo-print": "~14.0.3",
    "expo-router": "~4.0.11",
    "expo-secure-store": "~14.0.0",
    "expo-sharing": "~13.0.1",
    "expo-speech": "~13.0.0",
    "expo-status-bar": "~2.0.0",
    "expo-system-ui": "~4.0.4",
    "query-string": "^7.1.3",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-webview": "13.12.5"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "typescript": "~5.3.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "expo-av"
        ],
        "listUnknownPackages": false
      }
    }
  }
}
