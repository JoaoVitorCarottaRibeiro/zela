{
  "expo": {
    "name": "Zela",
    "slug": "zela",
    "scheme": "zela",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4BB9FA"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "A Zela usa o microfone para você falar os seus sintomas.",
        "NSPhotoLibraryUsageDescription": "A Zela usa suas fotos para analisar um exame ou um sintoma.",
        "NSCameraUsageDescription": "A Zela usa a câmera para você fotografar um exame ou um sintoma."
      }
    },
    "android": {
      "package": "com.zela.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#4BB9FA"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "A Zela usa suas fotos para analisar um exame ou um sintoma."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "A Zela usa o microfone para você falar os seus sintomas."
        }
      ],
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "cd189a76-137f-4f01-ae64-d72bcaa50793"
      }
    }
  }
}
